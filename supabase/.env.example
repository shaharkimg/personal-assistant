# Set with: supabase secrets set --env-file supabase/.env
AI_PROVIDER=anthropic            # anthropic | openai
AI_MODEL=claude-opus-5
AI_EFFORT=medium                 # low | medium | high
AI_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # used for embeddings/transcription unless overridden below
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_BASE_URL=          # e.g. https://api.groq.com/openai/v1 to switch vendor
AI_DAILY_REQUEST_LIMIT=500
CRON_SECRET=
EXPO_ACCESS_TOKEN=
ALLOWED_ORIGINS=
